{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$ref": "#/definitions/Preferences",
  "definitions": {
    "QueryHistoryPreference": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "homeTab": {
          "type": "string",
          "description": "one of: '' | 'query' | 'starred';"
        }
      }
    },
    "NavbarPreference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "bookmarkUrls"
      ],
      "properties": {
        "bookmarkUrls": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "Preferences": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "homeURL": {
          "type": "string",
          "description": "Explicit home URL (NOTE: this can only be modified in the system settings)"
        },
        "homeDashboardUID": {
          "type": "string",
          "description": "UID for the home dashboard"
        },
        "timezone": {
          "type": "string",
          "description": "The timezone selection"
        },
        "weekStart": {
          "type": "string",
          "description": "day of the week (sunday, monday, etc)"
        },
        "theme": {
          "type": "string",
          "description": "user interface theme"
        },
        "language": {
          "type": "string",
          "description": "Selected language"
        },
        "queryHistory": {
          "$ref": "#/definitions/QueryHistoryPreference",
          "description": "Explore query history preferences"
        },
        "navbar": {
          "$ref": "#/definitions/NavbarPreference",
          "description": "Navigation preferences"
        }
      }
    },
    "PreferencesApiVersion": {
      "type": "string",
      "const": "preferences.grafana.app/v1alpha1"
    },
    "PreferencesKind": {
      "type": "string",
      "const": "Preferences"
    }
  }
}